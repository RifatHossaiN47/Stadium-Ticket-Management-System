# Environment Variables Template
# Copy this file and rename to .env (which is gitignored)
# Or set these as environment variables on your hosting platform

# Database Configuration
DATABASE_URL=jdbc:mysql://your-host.com:3306/your-database?useSSL=true&serverTimezone=UTC
DATABASE_USERNAME=your_username
DATABASE_PASSWORD=your_password

# Application Settings
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8082
